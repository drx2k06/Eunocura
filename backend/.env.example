# EUNOCURA Backend Configuration
# All values have sensible defaults. Copy to .env and adjust as needed.

# Server Configuration
PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database (Optional for AI document paths; required for full portal CRUD)
# If omitted or unavailable, portal features degrade gracefully.
# MONGODB_URI=mongodb://localhost:27017/eunocura
# MONGODB_ALLOW_INVALID_CERTS=true

# Authentication / JWT
# SECRET_KEY=your-development-or-production-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Model Provider
# Options: ollama (default), gemini, none
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_SLM_MODEL=qwen2.5:7b-instruct
OLLAMA_MED_MODEL=medgemma:4b

# Optional Cloud Fallback (used when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemma-4-31b-it

# Model Response Cache
LLM_CACHE_ENABLED=1

# Storage (Local fallback used if R2 credentials omitted)
# R2_ENDPOINT=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# Speech-to-Text
STT_PROVIDER=whisper
WHISPER_MODEL=base
